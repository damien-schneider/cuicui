{
  "$schema": "https://json.schemastore.org/package",
  "name": "@cuicui/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "_build": "bun pre-build",
    "pre-build": "bun generate-preview-categories && bun generate-section-list",
    "type-check": "tsc --noEmit",
    "generate-preview-categories": "deno run --allow-read --allow-write scripts/generate-preview-categories.ts && bun biome format --write ./categories-previews-list.ts",
    "generate-section-list": "deno run --allow-read --allow-write scripts/generate-section-list/main.ts && bun biome format --write ./section-list.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@cuicui/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "4.3.1",
    "shiki": "1.18.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.7.2",
    "vitest": "2.0.5"
  },
  "dependencies": {
    "@ctrl/tinycolor": "4.1.0",
    "@number-flow/react": "^0.4.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-context-menu": "^2.2.3",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@uiw/react-signature": "1.3.1",
    "bezier-editor": "1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.0",
    "dom-to-image-more": "3.4.5",
    "embla-carousel-react": "8.5.1",
    "get-similar-color": "1.1.4",
    "jsbarcode": "3.11.6",
    "lucide-react": "^0.561.0",
    "motion": "^12.4.10",
    "next": "16.0.10",
    "next-themes": "0.4.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^1.7.1",
    "tts-react": "3.0.7"
  }
}
